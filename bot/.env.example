# Solana RPC (devnet). A free Helius devnet key works great; the public
# endpoint (https://api.devnet.solana.com) also works but is rate-limited.
SOLANA_RPC=https://devnet.helius-rpc.com/?api-key=YOUR_DEVNET_KEY
SOLANA_CLUSTER=devnet

# Optional: Discord adapter (same engine, both platforms from one process)
# DISCORD_TOKEN=your-discord-bot-token

# Dashboard DB proxy (Emblem:build injects these automatically when hosted;
# self-hosting: point lib/pdb.js at your own SQLite/Postgres layer)
# DASHBOARD_BASE=http://localhost:4000
# DASHBOARD_TOKEN=...
# ARTIFACT_GROUP=tagly
